# Database
DATABASE_URL=postgresql+asyncpg://yt_chatter:yt_chatter_dev@localhost:5432/yt_chatter
DATABASE_URL_SYNC=postgresql://yt_chatter:yt_chatter_dev@localhost:5432/yt_chatter

# Redis
REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3
YOUTUBE_API_KEY=

# Anthropic (LLM for claim extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (API-based embeddings & chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# FRED (macro/economic data)
FRED_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Embedding config
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Public base URL for YouTube WebSub callbacks (ngrok HTTPS URL locally; real API host in prod).
# No trailing slash. Leave empty to skip WebSub subscribe (RSS fallback still works if enabled).
PUBLIC_BASE_URL=

# YouTube WebSub (PubSubHubbub) — free Google hub
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
WEBSUB_SECRET=change-me-to-a-long-random-string
WEBSUB_LEASE_SECONDS=864000
WEBSUB_RENEW_MARGIN_HOURS=24

# RSS fallback poll interval in hours (0 = disabled). Secondary safety net only.
DISCOVERY_FALLBACK_POLL_HOURS=6

# Transcript retry delays in minutes after each failed caption fetch
TRANSCRIPT_RETRY_DELAYS_MINUTES=0,15,60,360,1440

# Whisper model for local ASR fallback when YouTube captions are unavailable
# Options: tiny.en (fastest), base.en, small.en, medium.en (most accurate)
WHISPER_MODEL_SIZE=tiny.en

# ── Authentication (Clerk) ───────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com, then:
#   - Secret key:        Dashboard → API Keys → Secret Keys (sk_test_...)
#   - JWT public key:    Dashboard → API Keys → Show JWT public key → PEM Public Key
#   - Authorized parties: comma-separated frontend origins allowed in the
#     token `azp` claim (CSRF protection — set your real origins in prod).
CLERK_SECRET_KEY=
# OPTIONAL (networkless verification). Leave EMPTY unless you have a reason:
# a static PEM goes stale whenever Clerk rotates its signing key (e.g. after
# editing the session token template) → intermittent token_invalid_signature
# 401s. The backend auto-falls back to JWKS when this happens, but JWKS-only
# (this var empty) is the rotation-safe default.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Clerk user ids auto-promoted to admin at first login (comma-separated).
# The first user to sign up is always promoted automatically, so this is
# only needed for additional bootstrap admins.
ADMIN_CLERK_USER_IDS=

# ── Usage analytics ──────────────────────────────────────────────────────
ANALYTICS_ENABLED=true
# Retention (days) for raw events / request logs / LLM usage rows.
# Daily rollup tables are never pruned.
ANALYTICS_RETENTION_DAYS=180

# ── TickerFlow / Market-Chatter ──────────────────────────────────────────
ADANOS_API_KEY=
ADANOS_PLAN=free
ADANOS_MONTHLY_BUDGET=225
ADANOS_BASE_URL=https://api.adanos.org
ADANOS_COLLECTION_DAYS=30
SENTIMENT_PROVIDER=native_raw
PRICE_PROVIDER=yfinance_local
API_CORS_ORIGINS=http://localhost:3000
PILOT_WATCHLIST=AAPL,NVDA
ENABLE_WATCHLIST_WORKER=false

